# ---------------------------------------------------------------------------
# Variáveis de ambiente — Plataforma de Presentes Digitais com NFC
# Copie para `.env` e preencha APENAS os valores do ambiente desejado.
# Nunca commite o `.env` com valores reais.
# ---------------------------------------------------------------------------

# Aplicação / marca
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Memória Eterna
NEXT_PUBLIC_BRAND_DOMAIN=memoriaeternaprime.com.br
NEXT_PUBLIC_SUPPORT_EMAIL=

# Banco de dados (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/foryoupage?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/foryoupage?schema=public

# Supabase (produção)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mercado Pago (sandbox)
MERCADO_PAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=
MERCADO_PAGO_WEBHOOK_SECRET=

# E-mails transacionais (Resend)
RESEND_API_KEY=
EMAIL_FROM=

# IA para criação assistida (DeepSeek)
# A chave permanece somente no servidor.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash

# Cron / jobs
CRON_SECRET=

# Segurança
APP_ENCRYPTION_KEY=

# Desenvolvimento
# Quando true, habilita o provedor de pagamento FAKE (SOMENTE desenvolvimento).
DEV_FAKE_PAYMENT_ENABLED=false
# Simula a criação com IA localmente, sem consumir a API da DeepSeek.
DEV_FAKE_AI_ENABLED=false
# Frete fixo do MVP (centavos e dias úteis)
SHIPPING_FIXED_CENTS=1990
SHIPPING_ESTIMATED_DAYS=7
